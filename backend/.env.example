# Backend only. The manual demo works with this left blank.
GEMINI_API_KEY=
# Browser-to-phone calling and optional Phase 2 audio processing. Backend only.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
# Both numbers must use E.164, e.g. +12065550123 (example only).
TWILIO_PHONE_NUMBER=
TEST_MEMBER_PHONE_NUMBER=
# Full HTTPS origin, e.g. https://your-tunnel.ngrok-free.app (no path).
PUBLIC_BACKEND_URL=
# Groq handles pre-call history. Gemini handles live guidance and transcription.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PRECALL_MODEL=openai/gpt-oss-120b
# Account headers may extend this interval to respect actual token limits.
GROQ_MIN_INTERVAL_SECONDS=1
GROQ_DEBOUNCE_SECONDS=0.7
# Per-track queue (250 typical 20 ms frames = 5 seconds); never disk audio.
TWILIO_AUDIO_QUEUE_FRAMES=250
# Live guidance uses GEMINI_UPDATE_MODEL. The legacy analysis setting is kept for standalone tools.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
GEMINI_UPDATE_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Independent voice identification on the same audio (in-memory WAV batches)
GEMINI_DIARIZATION_MODEL=gemini-3.5-transcribe
BATCH_DURATION_SECONDS=12
BATCH_OVERLAP_SECONDS=2
MAX_PENDING_BATCHES=3
DIARIZATION_WORD_TIMESTAMPS=true
# One contextual assessment by default; exact citation validation always runs
GUIDANCE_TIMEOUT_SECONDS=12
GUIDANCE_REVIEW_PASS=false
# Local development only. Change this token before sharing the server.
DEV_AUTH_TOKEN=wire-assist-local-dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_TRANSCRIPT_RETENTION=true
PROVIDER_TIMEOUT_SECONDS=30
# Pause failed history retries and analysis requests after HTTP 429
PROVIDER_RETRY_COOLDOWN_SECONDS=60
# Optional absolute paths:
# DATABASE_PATH=C:/path/to/wire-assist/backend/wire_assist.sqlite3
# DATA_DIR=C:/path/to/wire-assist/data
