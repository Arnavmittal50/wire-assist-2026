# Backend only. The manual demo works with this left blank.
GEMINI_API_KEY=
# Initial member-history review
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# Follow-up analysis of each finalized sentence
GEMINI_UPDATE_MODEL=gemini-3.5-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Local development only. Change this token before sharing the server.
DEV_AUTH_TOKEN=wire-assist-local-dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_TRANSCRIPT_RETENTION=true
PROVIDER_TIMEOUT_SECONDS=30
# Optional absolute paths:
# DATABASE_PATH=C:/path/to/wire-assist/backend/wire_assist.sqlite3
# DATA_DIR=C:/path/to/wire-assist/data
